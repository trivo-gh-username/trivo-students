# Copy to .env and fill in real values. Never commit .env.

# ── Domain ──────────────────────────────────────────────────────────────────
DOMAIN=students.trivoailabs.com

# ── Auth ────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=trivostudents
POSTGRES_PASSWORD=
POSTGRES_DB=trivo_students

# ── Deploy ──────────────────────────────────────────────────────────────────
IMAGE=ghcr.io/YOUR_ORG/trivo-students:latest
# Path to the shared edge/ stack (see ../edge/README.md), relative to this
# project's own folder. Only override if it's checked out somewhere unusual.
EDGE_DIR=../edge
